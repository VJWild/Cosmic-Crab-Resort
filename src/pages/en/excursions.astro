---
import Layout from '../../layouts/Layout.astro';
import ExcursionSection from '../../components/ExcursionSection.astro';
---

<Layout title="Bespoke Excursions | Cosmic Crab Resort">
  <main id="slider-main" class="bg-navy text-bone-white h-screen w-full relative overflow-hidden">
    
    <nav class="absolute right-6 md:right-10 top-1/2 -translate-y-1/2 flex flex-col items-center gap-6 z-50">
      <button id="prev-btn" class="text-bone-white/40 hover:text-ocean transition-colors duration-300 hover:-translate-y-1 disabled:opacity-10" aria-label="Previous section">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
        </svg>
      </button>

      <div class="flex flex-col gap-4">
        <button class="nav-dot w-2 h-2 rounded-full bg-bone-white/20 transition-all duration-500 hover:scale-150" data-index="0"></button>
        <button class="nav-dot w-2 h-2 rounded-full bg-bone-white/20 transition-all duration-500 hover:scale-150" data-index="1"></button>
        <button class="nav-dot w-2 h-2 rounded-full bg-bone-white/20 transition-all duration-500 hover:scale-150" data-index="2"></button>
      </div>

      <button id="next-btn" class="text-bone-white/40 hover:text-ocean transition-colors duration-300 hover:translate-y-1 disabled:opacity-10" aria-label="Next section">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </nav>

    <div id="slider-wrapper" class="w-full h-full transition-transform duration-1000 ease-[cubic-bezier(0.87,0,0.13,1)]">
      
      <ExcursionSection 
        number="01"
        tag="EXPEDITIONS"
        title="Private Sea Voyages"
        description="Navigate through coral sanctuaries and desert cays aboard our premium vessels. A total immersion in the turquoise blues of Bocas."
        img="https://images.unsplash.com/photo-1506905925346-21bda4d32df4"
      />

      <ExcursionSection 
        number="02"
        tag="ADVENTURE"
        title="Jungle Safari"
        description="Untamed trails and exotic wildlife. Explore the biodiversity of Carenero Island and discover the secrets hidden within the tropical brush."
        img="https://images.unsplash.com/photo-1551632811-561732d1e306"
        reverse={true}
      />

      <ExcursionSection 
        number="03"
        tag="CULTURE"
        title="Island Soul"
        description="Connect with the archipelago's heart. From ancestral cacao workshops to the Calypso rhythms that define life over the water."
        img="https://images.unsplash.com/photo-1469474968028-56623f02e42e"
      />

    </div>
  </main>
</Layout>

<script>
  import { initSliderLogic } from '../../scripts/scrollLogic.js';
  document.addEventListener('astro:page-load', initSliderLogic);
  initSliderLogic();
</script>