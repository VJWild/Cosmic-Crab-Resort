---
// src/pages/es/index.astro
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ExperiencesSection from '../../components/ExperiencesSection.astro'
import BookingForm from '../../components/BookingForm.astro';
import AtlantisSection from '../../components/AtlantisSection.astro';
import GalleryTeaser from '../../components/GalleryTeaser.astro';
---

<Layout title="Cosmic Crab Resort | Escape de Lujo en Bocas del Toro">

    <HeroSection />

    <main>
        <section id="explore" class="py-24 px-6 md:px-12 bg-bone-white font-sans">
            <div class="max-w-5xl mx-auto text-center">
                <h2 class="text-navy text-4xl md:text-5xl font-sans font-bold mb-6">Bienvenidos a Cosmic Crab Resort</h2>
                <div class="w-16 h-1 bg-coral mx-auto mb-8"></div>
                <p class="text-navy/80 text-lg leading-relaxed max-w-3xl mx-auto">
                    Te ayudaremos a experimentar la vida de Bocas en su verdadero sentido. Desde vivir entre los residentes hasta comer delicias auténticas, estamos seguros de que volverás a casa con recuerdos y momentos maravillosos.
                </p>
            </div>
        </section>

        <BookingForm />
        <ExperiencesSection/>
        <AtlantisSection/>
        <GalleryTeaser/>

        <section id="testimonials" class="py-24 bg-bone-white font-sans overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 md:px-12">
                <div class="text-center mb-16">
                    <p class="uppercase tracking-widest text-coral text-sm font-semibold mb-2">Experiencias de los Huéspedes</p>
                    <h2 class="text-navy text-4xl md:text-5xl font-sans font-bold mb-6">Historias desde el Paraíso</h2>
                    <div class="w-16 h-1 bg-coral mx-auto"></div>
                </div>
            </div>

            <!-- Contenedor del Slider Infinito -->
            <div class="relative w-full overflow-hidden flex gallery-container pb-8">
                <!-- Usamos una duración de animación un poco más lenta (50s) para que se lea cómodamente -->
                <div class="flex whitespace-nowrap animate-infinite-slider gap-8 px-4" style="animation-duration: 50s;">

                    <!-- ========================================== -->
                    <!-- BLOQUE 1 DE TARJETAS (6 Testimonios)       -->
                    <!-- ========================================== -->

                    <div class="testimonial-trigger bg-white p-8 md:p-10 shadow-xl border-t-4 border-coral relative cursor-pointer group hover:-translate-y-2 hover:shadow-2xl transition-all duration-500 w-[320px] md:w-[400px] flex-shrink-0 flex flex-col whitespace-normal"
                         data-name="Sarah & James" data-location="Nueva York, EE. UU."
                         data-text="¡Un sueño absoluto! La atención al detalle, la increíble mixología en Atlantis Bocas y la tranquilidad de las suites hicieron que nuestra luna de miel fuera inolvidable."
