---
import Layout from '../../layouts/Layout.astro';
import GallerySection from '../../components/GallerySection.astro';
---

<Layout title="Viaje Visual | Cosmic Crab Resort">
    <GallerySection />

    <div id="lightbox" class="fixed inset-0 z-[100] bg-navy/95 backdrop-blur-md hidden flex-col items-center justify-center opacity-0 transition-all duration-500">

        <button id="close-lightbox" class="absolute top-8 right-8 text-bone-white/50 hover:text-coral transition-colors p-2 z-[110]">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="relative max-w-[95vw] max-h-[85vh] flex items-center justify-center group">
            <img id="lightbox-img" src="" alt="Expanded View" class="max-w-full max-h-full object-contain shadow-2xl rounded-sm">

            <div class="absolute -bottom-12 left-0 w-full text-center">
                <p class="text-purple-cream font-sans uppercase tracking-[0.4em] text-[10px] font-bold">Cosmic Crab Resort — Experience</p>
            </div>
        </div>
    </div>

    <script src="../../scripts/lightbox.js"></script>
</Layout>