---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui.js';

const t = ui['es'];
---

<Layout title="Atlantis Bocas | Experiencia Ocean Premium">

    <section class="relative h-screen flex items-center justify-center overflow-hidden bg-navy">
        <div class="absolute inset-0">
            <img src="/images/photo-3-home.jpg" alt="Atlantis Bocas" class="w-full h-full object-cover scale-105 animate-slow-zoom opacity-60">
            <div class="absolute inset-0 bg-gradient-to-b from-navy/20 via-ocean/40 to-navy"></div>
        </div>

        <div class="relative z-10 text-center text-bone-white px-6 max-w-5xl mx-auto">
            <span class="inline-block uppercase tracking-[0.5em] text-[0.6rem] md:text-xs font-bold mb-4 py-2 px-6 border border-ocean bg-ocean/10 backdrop-blur-md">
                {t['atlantis.tag']}
            </span>
            <h1 class="text-6xl md:text-8xl lg:text-9xl font-luxury mb-6 drop-shadow-2xl text-bone-white">
                Atlantis <span class="text-ocean italic font-light">Bocas</span>
            </h1>
            <p class="text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed tracking-wide text-bone-white/90">
                {t['atlantis.subtitle']} — {t['atlantis.desc']}
            </p>
            <div class="flex flex-col md:flex-row gap-6 justify-center items-center">
                <a href="#menu" class="bg-ocean hover:bg-coral text-bone-white px-10 py-5 uppercase tracking-widest text-xs font-bold transition-all duration-500 shadow-xl w-64 text-center">
                    Ver Carta
                </a>
                <a href="#experiencia" class="border border-bone-white/30 hover:border-ocean hover:text-ocean text-bone-white px-10 py-5 uppercase tracking-widest text-xs font-bold transition-all duration-500 backdrop-blur-sm w-64 text-center">
                    La Experiencia
                </a>
            </div>
        </div>

        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
            <span class="text-[10px] uppercase tracking-[0.3em] text-ocean font-bold">Descubre</span>
            <div class="w-px h-12 bg-gradient-to-b from-ocean to-transparent"></div>
        </div>
    </section>

    <section id="experiencia" class="py-32 px-6 bg-bone-white overflow-hidden">
        <div class="max-w-7xl mx-auto">
            <div class="grid lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-7 relative group">
                    <div class="absolute -inset-4 border-2 border-ocean opacity-20 translate-x-8 translate-y-8 transition-transform duration-700 group-hover:translate-x-4 group-hover:translate-y-4"></div>
                    <img src="/images/room-1-home.jpg" alt="Concepto Atlantis" class="relative z-10 w-full h-[600px] object-cover shadow-2xl">
                    <div class="absolute -bottom-10 -left-10 bg-navy p-10 hidden md:block z-20 border-l-4 border-ocean">
                        <p class="text-ocean font-luxury text-4xl mb-2">Exclusivo</p>
                        <p class="text-bone-white/60 text-xs uppercase tracking-widest font-bold">Vistas sobre el agua</p>
                    </div>
                </div>
                
                <div class="lg:col-span-5">
                    <p class="text-ocean uppercase tracking-[0.4em] text-xs font-black mb-6">El Corazón de Bocas</p>
                    <h2 class="text-5xl md:text-6xl font-luxury text-navy mb-8 leading-[1.1]">
                        {t['atlantis.about.title']}
                    </h2>
                    <p class="text-navy/70 text-lg leading-relaxed mb-10 font-light">
                        {t['atlantis.about.desc']}
                    </p>
                    <div class="grid grid-cols-2 gap-8 border-t border-navy/10 pt-10">
                        <div>
                            <h4 class="text-navy font-bold text-sm uppercase mb-2">Ubicación</h4>
                            <p class="text-navy/60 text-sm">Muelle privado sobre el Mar Caribe.</p>
                        </div>
                        <div>
                            <h4 class="text-navy font-bold text-sm uppercase mb-2">Vibe</h4>
                            <p class="text-navy/60 text-sm">Lujo relajado y mixología de autor.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-32 px-6 bg-navy text-bone-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-ocean opacity-10 skew-x-12 translate-x-20"></div>
        
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center max-w-3xl mx-auto mb-24">
                <h2 class="text-4xl md:text-6xl font-luxury mb-6 italic">Arte en cada <span class="text-ocean">Copa</span></h2>
                <div class="w-24 h-1 bg-coral mx-auto mb-8"></div>
                <p class="text-bone-white/70 text-lg font-light">Nuestros bartenders no solo preparan tragos; crean homenajes líquidos a la biodiversidad de Panamá.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-12">
                <div class="border border-bone-white/10 p-8 hover:border-ocean transition-colors duration-500 group">
                    <span class="text-ocean font-luxury text-5xl block mb-6 opacity-40 group-hover:opacity-100 transition-opacity">01</span>
                    <h3 class="text-xl font-bold uppercase tracking-widest mb-4">Ingredientes Locales</h3>
                    <p class="text-bone-white/60 text-sm leading-relaxed">Frutas frescas de la isla, especias recolectadas a mano y destilados premium de la región.</p>
                </div>
                <div class="border border-bone-white/10 p-8 hover:border-ocean transition-colors duration-500 group">
                    <span class="text-ocean font-luxury text-5xl block mb-6 opacity-40 group-hover:opacity-100 transition-opacity">02</span>
                    <h3 class="text-xl font-bold uppercase tracking-widest mb-4">Swim-up Experience</h3>
                    <p class="text-bone-white/60 text-sm leading-relaxed">Disfruta de tu cóctel sin salir de la piscina en nuestras sillas sumergidas bajo el agua.</p>
                </div>
                <div class="border border-bone-white/10 p-8 hover:border-ocean transition-colors duration-500 group">
                    <span class="text-ocean font-luxury text-5xl block mb-6 opacity-40 group-hover:opacity-100 transition-opacity">03</span>
                    <h3 class="text-xl font-bold uppercase tracking-widest mb-4">Ritual del Atardecer</h3>
                    <p class="text-bone-white/60 text-sm leading-relaxed">Cada tarde celebramos la "Hora Dorada" con una selección especial de spritz y beats electrónicos suaves.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="menu" class="py-32 px-6 bg-bone-white">
        <div class="max-w-6xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-end mb-16 border-b border-navy/10 pb-12">
                <div>
                    <h2 class="text-5xl md:text-6xl font-luxury text-navy">{t['atlantis.menu.title']}</h2>
                    <p class="text-ocean uppercase tracking-[0.3em] font-black text-xs mt-4">Curaduría Gastronómica</p>
                </div>
                <div class="text-right mt-8 md:mt-0">
                    <p class="text-navy/40 font-bold mb-1 uppercase text-[10px] tracking-[0.2em]">{t['atlantis.hours.title']}</p>
                    <p class="text-navy font-luxury text-3xl">{t['atlantis.hours.time']}</p>
                    <p class="text-coral uppercase text-[10px] font-bold tracking-widest">{t['atlantis.hours.days']}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <div class="group cursor-pointer overflow-hidden relative shadow-2xl rounded-sm" onclick="openMenu(0)">
                    <img src="/images/atlantis-menu/1-1.png" alt="Menú 1" class="w-full h-auto transition-transform duration-1000 group-hover:scale-110">
                    <div class="absolute inset-0 bg-ocean/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-bone-white text-navy px-6 py-3 text-xs font-bold uppercase tracking-widest">Ampliar Página 1</span>
                    </div>
                </div>
                <div class="group cursor-pointer overflow-hidden relative shadow-2xl rounded-sm" onclick="openMenu(1)">
                    <img src="/images/atlantis-menu/2.png" alt="Menú 2" class="w-full h-auto transition-transform duration-1000 group-hover:scale-110">
                    <div class="absolute inset-0 bg-ocean/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-bone-white text-navy px-6 py-3 text-xs font-bold uppercase tracking-widest">Ampliar Página 2</span>
                    </div>
                </div>
                <div class="group cursor-pointer overflow-hidden relative shadow-2xl rounded-sm" onclick="openMenu(2)">
                    <img src="/images/atlantis-menu/3.png" alt="Menú 3" class="w-full h-auto transition-transform duration-1000 group-hover:scale-110">
                    <div class="absolute inset-0 bg-ocean/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-bone-white text-navy px-6 py-3 text-xs font-bold uppercase tracking-widest">Ampliar Página 3</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/95 backdrop-blur-lg opacity-0 transition-opacity duration-300 px-6 py-10">
        <button id="close-lightbox" class="absolute top-6 right-6 bg-bone-white/10 hover:bg-coral text-bone-white p-4 rounded-full border border-bone-white/10 hover:border-coral transition-all duration-300 hover:rotate-90 shadow-xl" aria-label="Cerrar menú ampliado">×</button>
        <img id="lightbox-img" src="" alt="Menú ampliado" class="max-w-[90vw] max-h-[80vh] object-contain rounded-xl shadow-[0_0_50px_rgba(0,0,0,0.5)] transition-transform duration-500 scale-95">
    </div>

    <section class="relative py-48 px-6 overflow-hidden">
        <div class="absolute inset-0 bg-navy">
            <img src="/images/photo-2-home.jpg" alt="Vibe" class="w-full h-full object-cover opacity-20">
            <div class="absolute inset-0 bg-gradient-to-r from-navy via-ocean/30 to-navy"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto text-center text-bone-white">
            <h2 class="text-5xl md:text-7xl font-luxury mb-8 leading-tight italic">Sumérgete en el <br><span class="text-ocean not-italic">Azul</span></h2>
            <p class="text-xl mb-12 font-light max-w-2xl mx-auto leading-relaxed text-bone-white/80">
                {t['atlantis.cta.desc']}
            </p>
            <a href="https://booking-directly.com/widgets/4Q4XUrH0pGe4DGJRgz8TCg4gHEhVMa5bFX11A4AGxQQXzlPSEKZKm9M4ocs95/properties?search_stay_dates=%22checkInDate%22:%222024-09-06%22,%22checkOutDate%22:%222024-09-07%22&search_occupancies=%5B%22numberOfAdults%22:2,%22children%22:%5B%5D%5D" target="_blank" class="bg-ocean hover:bg-coral text-bone-white px-12 py-6 uppercase tracking-[0.3em] text-xs font-bold transition-all duration-500 shadow-2xl">
                {t['atlantis.cta.btn']}
            </a>
        </div>
    </section>

</Layout>

<style>
    @keyframes slow-zoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.1); }
    }
    .animate-slow-zoom {
        animation: slow-zoom 25s infinite alternate ease-in-out;
    }
</style>

