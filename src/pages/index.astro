---
// src/pages/index.astro
// Importamos la plantilla maestra y los componentes creados
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout title="Cosmic Crab Resort | Luxury Escape in Bocas del Toro">
	<!-- Insertamos la barra de navegación -->
	<Navbar />

	<!-- Insertamos el HeroSection -->
	<HeroSection />

	<!-- Contenido principal de la Home -->
	<main>
		<!-- INTRO SECTION (Fondo Blanco Hueso) -->
		<section id="explore" class="py-24 px-6 md:px-12 bg-bone-white">
			<div class="max-w-5xl mx-auto text-center">
				<h2 class="text-navy text-4xl md:text-5xl font-luxury mb-6">Welcome to Cosmic Crab Resort</h2>
				<div class="w-16 h-1 bg-coral mx-auto mb-8"></div>
				<p class="text-navy/80 text-lg leading-relaxed max-w-3xl mx-auto">
					We will help you experience Bocas life in its true sense. From living among the residents to eating authentic delicacies you are sure to walk home with memories and wonderful moments.
				</p>
			</div>
		</section>

		<!-- FEATURED ROOM TEASER (Fondo Azul Marino para contraste) -->
		<section id="rooms-teaser" class="py-24 px-6 md:px-12 bg-navy text-bone-white">
			<div class="max-w-7xl mx-auto">

				<!-- Cabecera de la sección -->
				<div class="flex flex-col md:flex-row justify-between items-end mb-16">
					<div>
						<p class="uppercase tracking-widest text-coral-soft text-sm font-semibold mb-2">Accommodations</p>
						<h2 class="text-4xl md:text-5xl font-luxury">Immersive Island Living</h2>
					</div>
					<!-- Llamado a la acción general para ir a ver todas las habitaciones -->
					<a href="/rooms" class="mt-6 md:mt-0 inline-flex items-center gap-2 uppercase tracking-widest text-sm border-b border-bone-white pb-1 hover:text-coral hover:border-coral transition-colors group">
						View All Rooms
						<svg class="transform group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</a>
				</div>

				<!-- Reseña General de Habitaciones (Layout Horizontal Premium) -->
				<div class="flex flex-col lg:flex-row bg-bone-white text-navy shadow-2xl group cursor-pointer" onclick="window.location.href='/rooms'">

					<!-- Lado Izquierdo: Imagen -->
					<div class="lg:w-3/5 relative h-80 md:h-96 lg:h-[32rem] overflow-hidden">
						<img src="/images/room-1-home.jpg" alt="Cosmic Crab Resort Accommodations" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-[2000ms] ease-out">
						<!-- Overlay sutil que aparece en el hover -->
						<div class="absolute inset-0 bg-gradient-to-t from-navy/30 to-transparent lg:opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
					</div>

					<!-- Lado Derecho: Información -->
					<div class="lg:w-2/5 p-8 md:p-12 lg:p-16 flex flex-col justify-center relative">
						<!-- Acento decorativo superior en hover -->
						<div class="absolute top-0 left-0 w-full h-1 bg-coral scale-x-0 group-hover:scale-x-100 transition-transform duration-700 origin-left"></div>

						<h3 class="text-3xl lg:text-4xl font-luxury mb-4 text-navy">Your Gateway to Paradise</h3>
						<div class="w-12 h-0.5 bg-coral mb-6"></div>

						<p class="text-navy/80 text-base leading-relaxed mb-8">
							Surrounded by scenic beauty and attractive tourist attractions we make it convenient for you to visit all the beautiful places with our inhouse guide. We can also help you arrange transport facilities for an easier commute to nearby places.
						</p>

						<!-- Lista de Servicios/Amenidades -->
						<ul class="space-y-3 mb-10 text-sm text-navy/70">
							<li class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
								Services offered
							</li>
							<li class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
								Services offered
							</li>
							<li class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
								Services offered
							</li>
						</ul>

						<!-- Botón de acción -->
						<div class="mt-auto inline-flex items-center gap-3 text-coral uppercase tracking-widest text-sm font-bold transition-colors">
							Discover Our Rooms
							<svg class="transform group-hover:translate-x-2 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</div>
					</div>
				</div>

			</div>
		</section>

		<!-- RESTAURANT TEASER (Fondo Blanco Hueso) -->
		<section id="restaurant-teaser" class="py-24 px-6 md:px-12 bg-bone-white">
			<div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16">
				<div class="lg:w-1/2 relative">
					<!-- Imagen de Atlantis Bocas actualizada para ruta local -->
					<img src="/images/restaurant-home.jpg" alt="Cosmic Crab Cafe" class="w-full h-auto shadow-2xl">
					<!-- Cuadro decorativo (Accent Box) -->
					<div class="absolute -bottom-6 -right-6 w-48 h-48 border-2 border-navy -z-10 hidden md:block"></div>
				</div>
				<div class="lg:w-1/2">
					<p class="uppercase tracking-widest text-coral text-sm font-semibold mb-2">Dining Experience</p>
					<h2 class="text-navy text-4xl md:text-5xl font-luxury mb-6">Culinary Excellence</h2>
					<p class="text-navy/80 text-lg mb-8">
						Indulge in a journey of flavors. By day, enjoy fresh, locally-sourced Caribbean dishes at the <span class="font-bold text-navy">Cosmic Crab Cafe</span>. As the sun sets, immerse yourself in the vibrant, premium mixology experience of <span class="font-bold text-navy">Atlantis Bocas</span>.
					</p>
					<a href="/restaurant" class="inline-block bg-navy text-bone-white px-8 py-4 uppercase tracking-widest text-sm hover:bg-coral transition-colors duration-300">
						Explore Our Menus
					</a>
				</div>
			</div>
		</section>

		<!-- GALLERY TEASER (Slider Infinito - Fondo Azul Marino) -->
		<section id="gallery-teaser" class="py-24 bg-navy text-bone-white overflow-hidden">
			<div class="max-w-7xl mx-auto px-6 md:px-12 mb-16 text-center md:text-left flex flex-col md:flex-row justify-between items-end">
				<div>
					<p class="uppercase tracking-widest text-coral-soft text-sm font-semibold mb-2">Visual Journey</p>
					<h2 class="text-4xl md:text-5xl font-luxury">Our Inside Pictures</h2>
				</div>
				<a href="/gallery" class="mt-6 md:mt-0 uppercase tracking-widest text-sm border-b border-bone-white pb-1 hover:text-coral hover:border-coral transition-colors">
					View Full Gallery
				</a>
			</div>

			<!-- Contenedor del Slider Infinito -->
			<div class="relative w-full overflow-hidden flex gallery-container">
				<!-- Cinta de imágenes (Doble para lograr el loop perfecto) -->
				<div class="flex whitespace-nowrap animate-infinite-slider gap-4 px-2">

					<!-- PRIMER SET DE IMÁGENES -->
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<!-- Se separaron las transiciones: scale dura 2s, grayscale dura 0.4s -->
						<img src="/images/photo-1-home.jpg" alt="Resort View" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-2-home.jpg" alt="Relaxing Area" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-3-home.jpg" alt="Ocean View" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-4-home.jpeg" alt="Marina" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-5-home.jpg" alt="Details" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-6-home.jpg" alt="Details" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>

					<!-- SEGUNDO SET DE IMÁGENES (Exactamente igual al primero para el efecto infinito) -->
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-1-home.jpg" alt="Resort View" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-2-home.jpg" alt="Relaxing Area" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-3-home.jpg" alt="Ocean View" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-4-home.jpeg" alt="Marina" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-5-home.jpg" alt="Details" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>
					<div class="gallery-img-trigger relative w-[280px] md:w-[400px] h-[350px] md:h-[450px] overflow-hidden group cursor-pointer">
						<img src="/images/photo-6-home.jpg" alt="Details" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transform group-hover:scale-110" style="transition: transform 2s ease-out, filter 0.4s ease-out;">
						<div class="absolute inset-0 bg-navy/20 group-hover:bg-transparent transition-colors duration-500"></div>
					</div>

				</div>
			</div>
		</section>
	</main>

	<!-- FOOTER TEMPORAL (Se convertirá en un componente mas alantico') -->
	<footer id="contact" class="bg-navy text-bone-white py-16 px-6 md:px-12 border-t border-bone-white/10">
		<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
			<div>
				<a href="/" class="text-2xl font-luxury font-bold tracking-widest uppercase flex flex-col mb-6">
					<span>Cosmic Crab</span>
					<span class="text-[0.6rem] tracking-[0.4em] text-coral-soft font-sans">Resort & Marina</span>
				</a>
				<p class="text-bone-white/70 max-w-sm">The ultimate destination for those seeking the extraordinary. Where luxury meets the Caribbean nature.</p>
			</div>
			<div>
				<h4 class="font-semibold uppercase tracking-widest mb-6 text-coral-soft">Contact Us</h4>
				<ul class="space-y-4 text-bone-white/80">
					<li class="flex items-start gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0 mt-1"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
						Isla Carenero, Bocas del Toro, Panama
					</li>
					<li class="flex items-center gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
						reservations@cosmiccrabresort.com
					</li>
				</ul>
			</div>
			<div>
				<h4 class="font-semibold uppercase tracking-widest mb-6 text-coral-soft">Quick Links</h4>
				<ul class="space-y-3 text-bone-white/80">
					<li><a href="/rooms" class="hover:text-coral transition-colors">Our Rooms</a></li>
					<li><a href="/restaurant" class="hover:text-coral transition-colors">Dining & Bar</a></li>
					<li><a href="/gallery" class="hover:text-coral transition-colors">Photo Gallery</a></li>
				</ul>
			</div>
		</div>
	</footer>

	<!-- LIGHTBOX MODAL PREMIUM -->
	<div id="lightbox" class="fixed inset-0 z-[60] bg-navy/98 backdrop-blur-lg hidden flex-col items-center justify-center opacity-0 transition-opacity duration-500">

		<!-- Botón de Cierre Circular y Elegante -->
		<button id="close-lightbox" class="absolute top-6 right-6 lg:top-10 lg:right-10 bg-bone-white/10 hover:bg-coral text-bone-white p-4 rounded-full border border-bone-white/10 hover:border-coral transition-all duration-300 hover:rotate-90 shadow-xl group" aria-label="Close Gallery">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
		</button>

		<!-- Contenedor de la Imagen con Marco y Animación de Escala -->
		<div class="relative p-2 lg:p-4 flex flex-col items-center">
			<!-- Marco desfasado decorativo -->
			<div class="absolute inset-0 border border-bone-white/20 transform -translate-x-3 -translate-y-3 hidden md:block pointer-events-none"></div>
			<div class="absolute inset-0 border border-bone-white/20 transform translate-x-3 translate-y-3 hidden md:block pointer-events-none"></div>

			<!-- Imagen en sí -->
			<img id="lightbox-img" src="" alt="Gallery Image Expanded" class="relative z-10 max-w-[90vw] max-h-[80vh] object-contain shadow-[0_0_50px_rgba(0,0,0,0.5)] transform scale-95 transition-transform duration-700 ease-out">

			<p class="relative z-10 mt-8 text-bone-white/60 tracking-[0.3em] uppercase text-xs lg:text-sm font-light">Cosmic Crab Resort</p>
		</div>
	</div>

	<!-- Script de lógica del Lightbox -->
	<script src="../scripts/lightbox.js"></script>
</Layout>