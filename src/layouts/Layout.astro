---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
 title: string;
 description?: string;
}

const { title, description = "The Perfect Stay in Bocas del Toro" } = Astro.props;

// Lógica para detectar el idioma basado en la ruta
const idiomaActual = Astro.url.pathname.startsWith('/es') ? 'es' : 'en';
---

<!doctype html>
<html lang={idiomaActual} class="scroll-smooth">
<head>
 <meta charset="UTF-8" />
 <meta name="description" content={description} />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <link rel="icon" type="image/png" href="../public/images/Iconos/Icon 1.png" /> <meta name="generator" content={Astro.generator} />
 <title>{title}</title>

 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <!-- ACTUALIZADO: Montserrat 300, 400 (Regular), 500 (Medium), 600, 700 (Bold) + Playfair Display -->
 <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body class="antialiased selection:bg-coral-soft selection:text-navy">

<Navbar />

<slot />

<Footer />
</body>
</html>