---
// src/components/ContactSection.astro
import { ui } from '../i18n/ui.js';

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];
---

<!-- MINI HERO SECTION -->
<header class="relative h-[55vh] w-full flex items-center justify-center overflow-hidden border-b border-bone-white/10">
    <!-- PARA UNA FOTO (Cambiarla cuando la manden) -->
    <div class="absolute inset-0 bg-cover bg-center transform scale-105" style="background-image: url('https://images.unsplash.com/photo-1455587734955-081b22074882?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="absolute inset-0 bg-navy/60"></div>

    <div class="relative z-10 text-center text-bone-white mt-16 px-4">
        <p class="uppercase tracking-[0.4em] text-coral-soft text-sm font-semibold mb-4 animate-fade-in opacity-0">
            {t['contact.tag']}
        </p>
        <h1 class="text-5xl md:text-7xl font-luxury mb-6 animate-fade-in opacity-0 delay-300">
            {t['contact.title']}
        </h1>
        <div class="w-16 h-1 bg-coral mx-auto animate-fade-in opacity-0 delay-500"></div>
    </div>
</header>

<!-- SECCIÓN PRINCIPAL: INFO + FORMULARIO -->
<main class="py-24 px-6 md:px-12 bg-bone-white text-navy">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 mb-24">

        <!-- LADO IZQUIERDO: Información de Contacto -->
        <div class="flex flex-col justify-center">
            <h2 class="text-4xl md:text-5xl font-luxury mb-6">{t['contact.h2']}</h2>
            <div class="w-12 h-0.5 bg-coral mb-8"></div>
            <p class="text-navy/70 text-lg leading-relaxed mb-12">
                {t['contact.desc']}
            </p>

            <div class="space-y-10">
                <!-- Reception Office -->
                <div class="flex items-start gap-5">
                    <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center flex-shrink-0 text-coral-soft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                        <h4 class="font-bold uppercase tracking-widest text-xs mb-2 text-navy">{t['contact.office']}</h4>
                        <p class="text-navy/70 text-sm leading-relaxed">Cosmic Crab Resort,<br/>Isla Carenero, Bocas del Toro,<br/>Panama</p>
                    </div>
                </div>

                <!-- Reception Hours -->
                <div class="flex items-start gap-5">
                    <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center flex-shrink-0 text-coral-soft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div>
                        <h4 class="font-bold uppercase tracking-widest text-xs mb-2 text-navy">{t['contact.hours']}</h4>
                        <p class="text-navy/70 text-sm">8:30 AM - 8:00 PM</p>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="flex items-start gap-5">
                    <div class="w-12 h-12 rounded-full bg-navy flex items-center justify-center flex-shrink-0 text-coral-soft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div>
                        <h4 class="font-bold uppercase tracking-widest text-xs mb-2 text-navy">{t['contact.info']}</h4>
                        <p class="text-navy/70 text-sm mb-1"><a href="tel:+50761999949" class="hover:text-coral transition-colors">+507 6199-9949</a></p>
                        <p class="text-navy/70 text-sm"><a href="mailto:Info@CosmicCrabResort.com" class="hover:text-coral transition-colors">Info@CosmicCrabResort.com</a></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- LADO DERECHO: Formulario -->
        <div class="bg-white p-10 md:p-14 shadow-2xl border-t-4 border-coral relative">
            <div class="absolute inset-0 border border-navy/5 transform translate-x-3 translate-y-3 pointer-events-none hidden md:block"></div>

            <form action="#" method="POST" class="flex flex-col gap-8 relative z-10">
                <div class="flex flex-col gap-2">
                    <label for="name" class="uppercase tracking-widest text-[10px] font-bold text-navy/50">{t['contact.form.name']}</label>
                    <input type="text" id="name" name="name" required class="border-b border-navy/20 bg-transparent py-2 outline-none focus:border-coral transition-colors text-navy">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="email" class="uppercase tracking-widest text-[10px] font-bold text-navy/50">{t['contact.form.email']}</label>
                    <input type="email" id="email" name="email" required class="border-b border-navy/20 bg-transparent py-2 outline-none focus:border-coral transition-colors text-navy">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="message" class="uppercase tracking-widest text-[10px] font-bold text-navy/50">{t['contact.form.message']}</label>
                    <textarea id="message" name="message" rows="4" required class="border-b border-navy/20 bg-transparent py-2 outline-none focus:border-coral transition-colors text-navy resize-none"></textarea>
                </div>

                <button type="submit" class="mt-4 bg-navy hover:bg-coral text-bone-white px-8 py-4 uppercase tracking-widest text-sm font-bold transition-all duration-300 shadow-xl shadow-navy/10 hover:shadow-coral/20 hover:-translate-y-1">
                    {t['contact.form.send']}
                </button>
            </form>
        </div>

    </div>

    <!-- MAPA INMERSIVO A TODO LO ANCHO -->
    <div class="w-full h-[500px] md:h-[600px] overflow-hidden shadow-2xl relative group">
        <!-- Truco: Filtro grayscale que se quita con el hoversito -->
        <iframe
                loading="lazy"
                src="https://maps.google.com/maps?q=Cosmic%20Crab%20Resort%2C%20Bocas%20del%20Toro&t=m&z=15&output=embed&iwloc=near"
                title="Cosmic Crab Resort, Bocas del Toro"
                aria-label="Cosmic Crab Resort, Bocas del Toro"
                class="w-full h-full border-0 grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-[1500ms]"
        ></iframe>
        <!-- Indicador visual -->
        <div class="absolute top-6 left-6 bg-navy/80 backdrop-blur-md text-bone-white px-4 py-2 text-xs uppercase tracking-widest pointer-events-none opacity-100 group-hover:opacity-0 transition-opacity duration-500">
            Interactive Map
        </div>
    </div>
</main>