---
// src/components/GallerySection.astro

import Picture from 'astro/components/Picture.astro';
import Image from 'astro/components/Image.astro';

import cc28 from "../assets/images/CC Fotos/CC28.jpg"

import { ui } from '../i18n/ui.js';
import { galleryData } from '../data/galleryDataV2.js'; // base de datos externa

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];

// Pestañas de categorías
const categories = [
    { id: 'all', name: idiomaActual === 'es' ? 'Ver Todo' : 'View All' },
    { id: 'resort', name: t['gallery.cat.resort'] || 'Resort & Rooms' },
    { id: 'restaurant', name: t['gallery.cat.restaurant'] || 'Restaurant' },
    { id: 'atlantis', name: t['gallery.cat.atlantis'] || 'Atlantis & Pool' },
    { id: 'excursions', name: t['gallery.cat.excursions'] || 'Excursions' }
];


const allImages = Object.entries(galleryData).flatMap(([cat, images]) =>
    images.map(src => ({ src, cat }))
);
---

<!-- 1. HERO SECTION -->
<header class="relative h-screen w-full flex items-center justify-center overflow-hidden">
    <!-- IMAGEN ACTUALIZADA CON CC28.jpg -->
    <!-- <div
            class="absolute inset-0 bg-cover bg-center bg-no-repeat transform scale-105 transition-transform duration-[20s] ease-out hover:scale-110"
            style="background-image: url('/images/CC Fotos/CC28.jpg');"
    ></div> -->

    <Picture
        src={cc28}
        alt="Hero Gallery"
        formats={['avif', 'webp']} 
        widths={[480, 768, 1024, 1920]} 
        sizes="(max-width: 768px) 100vw, 1024px"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover transform scale-105 transition-transform duration-[20s] ease-out hover:scale-110 z-0"
    />

    <!-- Overlay para oscurecer la imagen y hacer legible el texto -->
    <div class="absolute inset-0 bg-black/40 z-0"></div>

    <!-- Contenido centrado -->
    <div class="relative z-10 text-center text-bone-white px-4 max-w-5xl flex flex-col items-center mt-16">
        <p class="uppercase tracking-[0.4em] text-sm md:text-base mb-6 text-purple-cream font-semibold font-sans animate-fade-in opacity-0 text-shadow-sm">
            {t['gallery.tag'] || 'Visual Journey'}
        </p>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-sans font-bold mb-8 leading-tight animate-fade-in opacity-0 delay-300 text-shadow-sm">
            {t['gallery.title'] || 'Our Gallery'}
        </h1>

        <div class="w-16 h-1 bg-coral mx-auto animate-fade-in opacity-0 delay-500"></div>
    </div>
</header>

<main class="py-24 bg-navy text-bone-white overflow-hidden relative font-sans min-h-screen">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-purple-cream/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">

        <div class="flex flex-wrap justify-center gap-4 md:gap-6 mb-16">
            {categories.map((cat, index) => (
                    <button
                            class={`filter-btn px-6 py-2 rounded-full border text-xs md:text-sm uppercase tracking-widest font-bold transition-all duration-300 ${index === 0 ? 'bg-purple-cream border-purple-cream text-navy' : 'border-bone-white/20 text-bone-white/60 hover:border-purple-cream hover:text-purple-cream'}`}
                            data-category={cat.id}
                    >
                        {cat.name}
                    </button>
            ))}
        </div>

        <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {allImages.map((img, index) => (
                    <div
                        class="gallery-item gallery-img-trigger relative aspect-[4/5] overflow-hidden group cursor-pointer shadow-lg rounded-sm"
                        data-cat={img.cat}
                    >
                        <Picture
                            src={img.src} 
                            formats={['avif', 'webp']}
                            widths={[400, 600, 800]} 
                            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                            alt={`Gallery Image - ${img.cat}`}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover transition-transform duration-[1500ms] group-hover:scale-110 grayscale-[15%] group-hover:grayscale-0"           
                        />
                        <div class="absolute inset-0 bg-navy/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center pointer-events-none">
                            <div class="w-14 h-14 rounded-full bg-navy/50 backdrop-blur-md border border-bone-white/30 flex items-center justify-center text-bone-white transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                            </div>
                            <span class="text-bone-white uppercase tracking-[0.3em] text-[10px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-100">
                                {idiomaActual === 'es' ? 'Ampliar Imagen' : 'Expand Image'}
                            </span>
                        </div>
                    </div>
            ))}
        </div>

    </div>
</main>

<script>
    // Lógica de Filtrado
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.gallery-item');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const category = btn.getAttribute('data-category');

                // 1. Cambiar los estilos del botón activo
                buttons.forEach(b => {
                    b.classList.remove('bg-purple-cream', 'border-purple-cream', 'text-navy');
                    b.classList.add('border-bone-white/20', 'text-bone-white/60');
                });
                btn.classList.remove('border-bone-white/20', 'text-bone-white/60');
                btn.classList.add('bg-purple-cream', 'border-purple-cream', 'text-navy');

                // 2. Filtrar las imágenes con transición suave
                items.forEach(item => {
                    const itemCat = item.getAttribute('data-cat');
                    const element = item as HTMLElement;

                    if (category === 'all' || itemCat === category) {
                        element.style.display = 'block';

                        setTimeout(() => {
                            element.style.opacity = '1';
                            element.style.transform = 'scale(1)';
                        }, 10);
                    } else {
                        element.style.opacity = '0';
                        element.style.transform = 'scale(0.95)';

                        setTimeout(() => {
                            element.style.display = 'none';
                        }, 300);
                    }
                });
            });
        });
    });
</script>

<style>
    .gallery-item {
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
    }
</style>