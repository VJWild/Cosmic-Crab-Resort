---
import type { ImageMetadata } from 'astro';
import Picture from 'astro/components/Picture.astro';

interface Props {
  number: string;
  tag: string;
  title: string;
  description: string;
  img: ImageMetadata;
  price?: string;
  duration?: string;
  highlights?: string[];
  reverse?: boolean;
  isLazy?: boolean;
}

const { 
  number, tag, title, description, img, 
  price, duration, highlights, reverse = false, isLazy = true 
} = Astro.props;
---

<section class="h-screen w-full flex flex-col md:flex-row overflow-hidden flex-shrink-0">
  <div class={`w-full md:w-1/2 h-[45%] md:h-full relative overflow-hidden group ${reverse ? 'md:order-last' : ''}`}>
    <Picture
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2000ms] ease-out group-hover:scale-110 group-hover:rotate-1"
        src={img}
        alt={title}
        formats={['avif', 'webp']} 
        widths={[480, 768, 1024, 1920]} 
        sizes="(max-width: 768px) 100vw, 1024px"
        loading={isLazy ? "lazy" : "eager"}
    />
    <div class="absolute inset-0 opacity-0 group-hover:animate-[shine_1.5s_ease-in-out] bg-gradient-to-r from-transparent via-bone-white/20 to-transparent -translate-x-full rotate-45 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy/70 to-transparent transition-opacity duration-700 group-hover:opacity-30"></div>
  </div>

  <div class="w-full md:w-1/2 h-[55%] md:h-full flex items-center justify-center p-8 md:pt-20 md:p-16 bg-navy text-bone-white overflow-y-auto no-scrollbar">
    <div class="max-w-lg w-full">
      <span class="text-ocean tracking-[0.3em] text-[10px] md:text-xs font-mono uppercase block mb-3 md:mb-4 opacity-80">
        {number} / {tag}
      </span>
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-none text-bone-white font-luxury mb-4 md:mb-6">
        {title}
      </h2>
      
      {(price || duration) && (
        <div class="flex gap-6 text-bone-white/60 text-[10px] md:text-xs font-mono uppercase tracking-widest border-b border-bone-white/10 pb-4 mb-4">
          {duration && <span><strong class="text-ocean">Dur:</strong> {duration}</span>}
          {price && <span><strong class="text-ocean">P/P:</strong> {price}</span>}
        </div>
      )}

      <p class="text-bone-white text-sm md:text-base leading-relaxed font-light opacity-80 mb-6">
        {description}
      </p>

      {highlights && highlights.length > 0 && (
        <ul class="space-y-2">
          {highlights.map((item) => (
            <li class="flex items-start gap-3 text-bone-white/70 text-xs md:text-sm font-light">
              <svg class="w-4 h-4 text-coral shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>