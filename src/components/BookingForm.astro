---
// src/components/BookingForm.astro
import { ui } from '../i18n/ui.js';

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];
---

<div class="w-full flex justify-center py-8">
    <form id="hero-booking-form" class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-4 w-full max-w-5xl px-6" method="POST" target="_blank" action="https://portal.freetobook.com/widget-redir">
        
        <input type="hidden" name="w_id" value="27788">
        <input type="hidden" name="w_tkn" value="4Q4XUrH0pGe4DGJRgz8TCg4gHEhVMa5bFX11A4AGxQQXzlPSEKZKm9M4ocs95">
        <input type="hidden" name="stayLength" id="hero-stayLength" value="1">

        <div class="flex flex-col items-start gap-2 w-full md:w-56">
            <label class="text-[0.7rem] uppercase tracking-[0.2em] text-coral font-bold ml-1 opacity-70">
                {t['book.checkin']}
            </label>
            <input 
                type="date" 
                id="hero-checkIn" 
                name="checkIn" 
                class="w-full bg-white border border-navy/10 text-navy text-sm p-4 outline-none focus:border-coral focus:ring-1 focus:ring-coral/20 transition-all duration-300 shadow-sm rounded-sm [color-scheme:light]" 
                required
            >
        </div>

        <div class="flex flex-col items-start gap-2 w-full md:w-56">
            <label class="text-[0.7rem] uppercase tracking-[0.2em] text-coral font-bold ml-1 opacity-70">
                {t['book.checkout']}
            </label>
            <input 
                type="date" 
                id="hero-checkOut" 
                class="w-full bg-white border border-navy/10 text-navy text-sm p-4 outline-none focus:border-coral focus:ring-1 focus:ring-coral/20 transition-all duration-300 shadow-sm rounded-sm [color-scheme:light]" 
                required
            >
        </div>

        <div class="pt-6 w-full md:w-auto">
            <button type="submit" class="w-full bg-coral hover:bg-navy text-bone-white px-10 py-4.5 md:py-[1.15rem] uppercase tracking-[0.2em] text-xs font-bold transition-all duration-500 shadow-lg shadow-coral/20 hover:-translate-y-0.5 active:translate-y-0">
                {t['book.button']}
            </button>
        </div>
    </form>
</div>

<script src="../scripts/booking.js"></script>