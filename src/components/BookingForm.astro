---
import { ui } from '../i18n/ui.js';

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];
---

<div class="w-full max-w-4xl p-0 m-0 bg-transparent animate-fade-in opacity-0 delay-500">
    <form id="hero-booking-form" class="flex flex-col md:flex-row items-center justify-center gap-4" method="POST" target="_blank" action="https://portal.freetobook.com/widget-redir">
        
        <input type="hidden" name="w_id" value="27788">
        <input type="hidden" name="w_tkn" value="4Q4XUrH0pGe4DGJRgz8TCg4gHEhVMa5bFX11A4AGxQQXzlPSEKZKm9M4ocs95">
        <input type="hidden" name="stayLength" id="hero-stayLength" value="1">

        <div class="flex flex-col items-start gap-1 w-full md:w-44">
            <span class="text-[0.6rem] uppercase tracking-widest text-coral-soft font-bold ml-1">{t['book.checkin']}</span>
            <input type="date" id="hero-checkIn" name="checkIn" class="w-full bg-white/10 backdrop-blur-sm border border-bone-white/20 text-bone-white text-xs p-3 outline-none focus:border-coral transition-colors [color-scheme:white]" required>
        </div>

        <div class="flex flex-col items-start gap-1 w-full md:w-44">
            <span class="text-[0.6rem] uppercase tracking-widest text-coral-soft font-bold ml-1">{t['book.checkout']}</span>
            <input type="date" id="hero-checkOut" class="w-full bg-white/10 backdrop-blur-sm border border-bone-white/20 text-bone-white text-xs p-3 outline-none focus:border-coral transition-colors [color-scheme:white]" required>
        </div>

        <div class="pt-5 w-full md:w-auto">
            <button type="submit" class="w-full bg-coral hover:bg-red-600 text-bone-white px-8 py-3.5 uppercase tracking-widest text-xs font-bold transition-all duration-300 shadow-lg">
                {t['book.button']}
            </button>
        </div>
    </form>
</div>

<script src="../scripts/booking.js"></script>