---
import { ui } from '../i18n/ui.js';
import Image from 'astro/components/Image.astro';
import ExperienceSectionImage from './ExperienceSectionImage.astro';
import excursiones from '../assets/images/excursiones.jpg'
import cafe from '../assets/images/restaurant.jpg'
import boutique from '../assets/images/CC Fotos/CC16.jpg'

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];
---
<!-- ========================================================================= -->
<!-- SECCIÓN UNIFICADA: EXPERIENCIAS (Excursiones, Restaurant & Boutique) -->
<!-- ========================================================================= -->
<section id="experiences" class="py-24 px-6 md:px-12 bg-bone-white font-sans">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <p class="uppercase tracking-widest text-coral text-sm font-semibold mb-2">{t["experiences.tag"]}</p>
            <h2 class="text-navy text-4xl md:text-5xl font-sans font-bold mb-6">{t["experiences.title"]}</h2>
            <div class="w-16 h-1 bg-coral mx-auto"></div>
            <p class="text-navy/70 text-lg mt-6 max-w-2xl mx-auto">{t['experiences.description']}</p>
        </div>

        <!-- Grid de 3 columnas verticales -->
        <div id="image-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-8 opacity-0 transition-opacity duration-500">

            <!-- Columna 1: Excursiones -->
            <ExperienceSectionImage
                href={`/${idiomaActual}/excursions`}
                src={excursiones}
                tag={t['experiences.excursions.tag']}
                description={t['experiences.excursions.description']}
                title={t['experiences.excursions.title']}
            />

            <!-- Columna 2: Cosmic Crab Cafe -->
            <ExperienceSectionImage
                href={`/${idiomaActual}/restaurant`}
                src={cafe}
                tag={t['experiences.cafe.tag']}
                description={t['experiences.cafe.description']}
                title={t['experiences.cafe.title']}
            />

            <!-- Columna 3: - Boutique & Joyería -->
            <ExperienceSectionImage
                href={`/${idiomaActual}/boutique`}
                src={boutique}
                tag={t['experiences.boutique.tag']}
                description={t['experiences.boutique.description']}
                title={t['experiences.boutique.title']}
            />
        </div>
    </div>
</section>
<script>
    const imageGrid = document.getElementById('image-grid');

    if(imageGrid){
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting){
                    imageGrid.classList.remove('opacity-0');
                    observer.unobserve(imageGrid);
                }
            });
        }, {rootMargin:"50px"});

        observer.observe(imageGrid);
    }
</script>