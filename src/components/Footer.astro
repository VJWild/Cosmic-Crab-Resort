                                <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-bone-white/20 flex items-center justify-center text-bone-white hover:bg-coral hover:border-coral transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-coral/20" aria-label="Facebook">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
                                <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-bone-white/20 flex items-center justify-center text-bone-white hover:bg-coral hover:border-coral transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-coral/20" aria-label="Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
