                </a>
                                <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-bone-white/20 flex items-center justify-center text-bone-white hover:bg-coral hover:border-coral transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-coral/20" aria-label="YouTube">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33zM9.75 15.02V8.48l6.15 3.27-6.15 3.27z"/></svg>
                </a>
                                <a href="#" target="_blank" class="w-10 h-10 rounded-full border border-bone-white/20 flex items-center justify-center text-bone-white hover:bg-coral hover:border-coral transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg hover:shadow-coral/20" aria-label="TikTok">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                </a>
            </div>
        </div>
    </div>

        <div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-bone-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-bone-white/50 text-xs tracking-widest uppercase">
        <p>&copy; {new Date().getFullYear()} Cosmic Crab Resort. {t['footer.rights']}</p>
        <div class="flex gap-6">
            <a href="#" class="hover:text-coral transition-colors">{t['footer.privacy']}</a>
            <a href="#" class="hover:text-coral transition-colors">{t['footer.terms']}</a>
