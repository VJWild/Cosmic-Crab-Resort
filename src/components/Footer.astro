---
// src/components/Footer.astro
import { ui } from '../i18n/ui.js';

const pathname = Astro.url.pathname;
let idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';

const t = ui[idiomaActual];
const base = idiomaActual === 'es' ? '/es' : '/en';
---

<footer id="contact" class="bg-navy text-bone-white py-20 px-6 md:px-12 border-t border-bone-white/10 relative overflow-hidden">
<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-coral to-transparent opacity-50"></div>

 <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

<div class="flex flex-col">
 <a href={base + "/"} class="flex items-center gap-4 mb-6 group">
<img src="/images/Coral.png" alt="Cosmic Crab Isotipo" class="w-12 h-12 md:w-14 md:h-14 object-contain transition-transform duration-500 group-hover:scale-110" onerror="this.style.display='none'"/>

<div class="text-2xl font-luxury font-bold tracking-widest uppercase flex flex-col">
 <span>Cosmic Crab</span>
 <span class="text-[0.6rem] tracking-[0.4em] text-coral-soft font-sans font-semibold">Resort</span>
  </div>
   </a>
   <p class="text-bone-white/70 text-sm leading-relaxed mb-6">
    {t['footer.description']}
   </p>
    </div>

        <div>
      <h4 class="font-semibold uppercase tracking-widest mb-6 text-coral-soft text-sm">{t['footer.visitTitle']}</h4>
          <ul class="space-y-5 text-sm text-bone-white/80">
                <li class="flex items-start gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0 mt-0.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>{t['footer.location']}</span>
                </li>
                <li class="flex items-start gap-4 pt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <div>
                        <span class="block text-bone-white font-medium mb-1">{t['footer.hoursTitle']}</span>
                        <span>{t['footer.hoursDays']}</span>
                    </div>
                </li>
            </ul>
        </div>

                <div>
            <h4 class="font-semibold uppercase tracking-widest mb-6 text-coral-soft text-sm">{t['footer.reservationTitle']}</h4>
            <ul class="space-y-5 text-sm text-bone-white/80">
                <li class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <a href="tel:+50761999949" class="hover:text-coral transition-colors font-medium text-bone-white text-base">+507 6199 – 9949</a>
                </li>
                <li class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-coral flex-shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <a href="mailto:Info@cosmiccrabresort.com" class="hover:text-coral transition-colors">Info@cosmiccrabresort.com</a>
                </li>
            </ul>
        </div>

                <div>
