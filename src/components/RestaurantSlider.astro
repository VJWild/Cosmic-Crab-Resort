---
// src/components/RestaurantSlider.astro
import { ui } from '../i18n/ui.js';

import Image from 'astro/components/Image.astro';
import Picture from 'astro/components/Picture.astro';

import atlantis from "../assets/images/photo-2-home.jpg";
import atlantisLogo from "../assets/images/Iconos/Icon 2.png"
import cosmic from "../assets/images/restaurant-home.jpg"
import cosmicLogo from "../assets/images/Iconos/Icon 4.png"

const pathname = Astro.url.pathname;
let idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];

// Definimos la ruta del PDF dinámicamente según el idioma
const menuPdfUrl = idiomaActual === 'es' ? '/MENU(1).pdf' : '/MENU.pdf';
---

<main class="relative w-full h-screen overflow-hidden bg-navy flex font-sans" id="split-container">

    <!-- ========================================== -->
    <!-- LADO IZQUIERDO: ATLANTIS POOL & SWIM-UP BAR -->
    <!-- ========================================== -->
    <section id="left-panel" class="relative h-full flex-shrink-0 z-10 cursor-pointer overflow-hidden" style="width: 50%;">
        <Picture
            class="absolute inset-0 w-full h-full object-cover"
            src={atlantis}
            alt="Atlantis Bocas Mixology"
            formats={['avif', 'webp']} 
            widths={[480, 768, 1024, 1920]} 
            sizes="(max-width: 768px) 100vw, 1024px"
            loading="eager"
        />
        <div class="absolute inset-0 bg-navy/50 transition-colors duration-500 hover:bg-navy/40"></div>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 lg:p-16">

            <div id="left-title" class="flex flex-col items-center gap-5 transition-all duration-300 transform animate-fade-in opacity-0">
                <Image
                    class="w-20 h-20 md:w-24 md:h-24 object-contain drop-shadow-xl"
                    src={atlantisLogo}
                    alt="Atlantis Bocas Logo"
                    onerror="this.style.display='none'"
                    loading="eager"
                />
                <h2 class="text-bone-white text-4xl md:text-6xl font-sans font-bold drop-shadow-xl whitespace-nowrap">
                    {t['rest.left.title']} <br><span class="italic font-normal text-coral-soft text-2xl md:text-4xl">{t['rest.left.subtitle']}</span>
                </h2>
            </div>

            <div id="left-details" class="absolute inset-0 flex flex-col items-center justify-center p-8 lg:p-20 opacity-0 translate-y-4 pointer-events-none transition-all duration-500">
                <Image
                    class="w-16 h-16 md:w-20 md:h-20 object-contain drop-shadow-xl mb-4"
                    src={atlantisLogo}
                    alt="Atlantis Bocas Logo"
                    onerror="this.style.display='none'"
                    loading="lazy"
                />
                <p class="uppercase tracking-[0.3em] text-coral-soft text-sm font-semibold font-sans mb-4">{t['rest.left.tag']}</p>
                <h2 class="text-bone-white text-5xl md:text-7xl font-sans font-bold mb-6">{t['rest.left.h2']}</h2>
                <div class="w-12 h-1 bg-coral mb-6"></div>
                <p class="text-bone-white/90 text-base md:text-lg max-w-xl mb-10 leading-relaxed font-normal font-sans">
                    {t['rest.left.desc']}
                </p>

                <a href={menuPdfUrl} target="_blank" rel="noopener noreferrer" class="menu-btn inline-flex items-center gap-3 bg-coral hover:bg-coral-intense text-bone-white px-8 py-4 uppercase tracking-widest text-sm font-bold font-sans transition-all duration-300 shadow-lg shadow-coral/20">
                    {t['rest.left.btn']}

                </a>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- LADO DERECHO: COSMIC CRAB CAFE            -->
    <!-- ========================================== -->
    <section id="right-panel" class="relative h-full flex-shrink-0 z-10 cursor-pointer overflow-hidden" style="width: 50%;">
        <Picture
            class="absolute inset-0 w-full h-full object-cover"
            src={cosmic}
            alt="Cosmic Crab Cafe Food"
            formats={['avif', 'webp']} 
            widths={[480, 768, 1024, 1920]} 
            sizes="(max-width: 768px) 100vw, 1024px"
            loading="eager"
        />
        <div class="absolute inset-0 bg-black/40 transition-colors duration-500 hover:bg-black/30"></div>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-8 lg:p-16">

            <div id="right-title" class="flex flex-col items-center gap-5 transition-all duration-300 transform animate-fade-in opacity-0">
                <Image
                    class="w-20 h-20 md:w-24 md:h-24 object-contain drop-shadow-xl"
                    src={cosmicLogo}
                    alt="Cosmic Crab Cafe Logo"
                    onerror="this.style.display='none'"
                    loading="eager"
                />
                <h2 class="text-bone-white text-4xl md:text-6xl font-sans font-bold drop-shadow-xl whitespace-nowrap">
                    {t['rest.right.title']} <br><span class="italic font-normal text-coral-soft text-2xl md:text-4xl">{t['rest.right.subtitle']}</span>
                </h2>
            </div>

            <div id="right-details" class="absolute inset-0 flex flex-col items-center justify-center p-8 lg:p-20 opacity-0 translate-y-4 pointer-events-none transition-all duration-500">
                <Image
                    class="w-16 h-16 md:w-20 md:h-20 object-contain drop-shadow-xl mb-4"
                    src={cosmicLogo}
                    alt="Cosmic Crab Cafe Logo"
                    onerror="this.style.display='none'"
                    loading="lazy"
                />
                <p class="uppercase tracking-[0.3em] text-coral text-sm font-semibold font-sans mb-4">{t['rest.right.tag']}</p>
                <h2 class="text-bone-white text-5xl md:text-7xl font-sans font-bold mb-6">{t['rest.right.h2']}</h2>
                <div class="w-12 h-1 bg-coral mb-6"></div>
                <p class="text-bone-white/90 text-base md:text-lg max-w-xl mb-10 leading-relaxed font-normal font-sans">
                    {t['rest.right.desc']}
                </p>

                <a href={menuPdfUrl} target="_blank" rel="noopener noreferrer" class="menu-btn inline-flex items-center gap-3 bg-transparent border border-bone-white text-bone-white px-8 py-4 uppercase tracking-widest text-sm font-bold font-sans hover:bg-bone-white hover:text-navy transition-all duration-300">
                    {t['rest.right.btn']}
                </a>
            </div>
        </div>
    </section>

    <!-- BARRA DIVISORIA ARRASTRABLE (SLIDER) -->
    <div id="slider-divider" class="absolute top-0 bottom-0 w-8 md:w-12 -ml-4 md:-ml-6 cursor-col-resize z-30 flex flex-col items-center justify-center group" style="left: 50%;">
        <div class="absolute top-0 bottom-0 w-[2px] bg-bone-white/30 group-hover:bg-coral transition-colors duration-300"></div>
        <div class="relative w-12 h-12 md:w-16 md:h-16 rounded-full bg-navy/80 backdrop-blur-md border border-bone-white/20 flex items-center justify-center text-bone-white shadow-[0_0_20px_rgba(0,0,0,0.5)] group-hover:scale-110 group-hover:border-coral transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-bone-white group-hover:text-coral transition-colors"><path d="m15 18 6-6-6-6"/><path d="m9 18-6-6 6-6"/></svg>
        </div>
        <span class="absolute mt-24 text-[10px] uppercase tracking-widest text-bone-white/70 bg-navy/50 px-2 py-1 rounded backdrop-blur-sm pointer-events-none opacity-100 group-hover:opacity-0 transition-opacity font-sans">{t['rest.slider.drag']}</span>
    </div>
</main>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('split-container');
        const leftPanel = document.getElementById('left-panel');
        const rightPanel = document.getElementById('right-panel');
        const divider = document.getElementById('slider-divider');

        const leftTitle = document.getElementById('left-title');
        const rightTitle = document.getElementById('right-title');
        const leftDetails = document.getElementById('left-details');
        const rightDetails = document.getElementById('right-details');

        let isDragging = false;

        setTimeout(() => {
            if(leftTitle) { leftTitle.classList.remove('animate-fade-in'); leftTitle.classList.add('opacity-100', 'scale-100'); }
            if(rightTitle) { rightTitle.classList.remove('animate-fade-in'); rightTitle.classList.add('opacity-100', 'scale-100'); }
        }, 1200);

        const updatePanels = (clientX) => {
            const rect = container.getBoundingClientRect();
            let percentage = ((clientX - rect.left) / rect.width) * 100;
            if (percentage < 15) percentage = 15;
            if (percentage > 85) percentage = 85;

            leftPanel.style.width = `${percentage}%`;
            rightPanel.style.width = `${100 - percentage}%`;
            divider.style.left = `${percentage}%`;

            if (percentage > 60 || percentage < 40) {
                leftTitle.classList.remove('opacity-100', 'scale-100');
                leftTitle.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                rightTitle.classList.remove('opacity-100', 'scale-100');
                rightTitle.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
            } else {
                leftTitle.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                leftTitle.classList.add('opacity-100', 'scale-100');
                rightTitle.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                rightTitle.classList.add('opacity-100', 'scale-100');
            }

            if (percentage > 65) {
                leftDetails.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                leftDetails.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
            } else {
                leftDetails.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                leftDetails.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            }

            if (percentage < 35) {
                rightDetails.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                rightDetails.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
            } else {
                rightDetails.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                rightDetails.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            }
        };

        divider.addEventListener('mousedown', (e) => {
            isDragging = true;
            container.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });
        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            updatePanels(e.clientX);
        });
        window.addEventListener('mouseup', () => {
            if(isDragging) {
                isDragging = false;
                container.style.cursor = 'default';
                document.body.style.userSelect = '';
            }
        });

        divider.addEventListener('touchstart', (e) => {
            isDragging = true;
            document.body.style.overflow = 'hidden';
        }, {passive: true});
        window.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            updatePanels(e.touches[0].clientX);
        });
        window.addEventListener('touchend', () => {
            isDragging = false;
            document.body.style.overflow = '';
        });

        leftPanel.addEventListener('click', (e) => {
            if(e.target.closest('.menu-btn') || isDragging) return;
            const currentWidth = parseFloat(leftPanel.style.width || 50);
            if (currentWidth < 65) {
                updatePanels(container.getBoundingClientRect().width * 0.75 + container.getBoundingClientRect().left);
            }
        });
        rightPanel.addEventListener('click', (e) => {
            if(e.target.closest('.menu-btn') || isDragging) return;
            const currentWidth = parseFloat(leftPanel.style.width || 50);
            if (currentWidth > 35) {
                updatePanels(container.getBoundingClientRect().width * 0.25 + container.getBoundingClientRect().left);
            }
        });
    });
</script>