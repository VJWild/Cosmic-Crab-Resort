---
// src/components/MenuViewer.astro
import Layout from '../layouts/Layout.astro';

interface Props {
    title: string;
    images: string[];
    backLink: string;
    lang: 'en' | 'es';
    logo?: string;
    cornerLogo?: string;
}

const { title, images, backLink, lang, logo, cornerLogo } = Astro.props;

const hint = lang === 'es' ? 'Toca para hacer Zoom' : 'Tap to Zoom';
const backText = lang === 'es' ? 'Volver al Restaurante' : 'Back to Restaurant';
---

<Layout title={title}>
    <!-- Envoltorio Fijo a pantalla completa -->
    <main class="fixed inset-0 z-[100] bg-navy overflow-hidden">

        <!-- HEADER DEL VISOR (Responsivo) -->
        <div class="absolute top-0 left-0 w-full px-4 md:px-8 pt-4 md:pt-8 pb-8 md:pb-16 flex flex-col md:flex-row justify-between items-start z-50 pointer-events-none bg-gradient-to-b from-navy/95 via-navy/70 to-transparent">

            <!-- Botón Volver (Reducido de tamaño) -->
            <a href={backLink} class="relative z-10 pointer-events-auto inline-flex items-center gap-1.5 md:gap-2 text-bone-white uppercase tracking-widest text-[9px] md:text-[10px] font-bold bg-navy/50 hover:bg-coral px-3 md:px-4 py-2 md:py-2.5 rounded-full backdrop-blur-md border border-bone-white/20 hover:border-coral transition-all duration-300 ease-out hover:-translate-x-2 hover:shadow-[0_0_30px_rgba(239,64,60,0.4)] mb-4 md:mb-0 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-1 transition-transform duration-300 md:w-[16px] md:h-[16px]"><path d="m15 18-6-6 6-6"/></svg>
                <span class="hidden sm:inline">{backText}</span>
                <span class="inline sm:hidden">Back</span>
            </a>

            <!-- CENTRO: Logo + Título -->
            <div class="relative md:absolute md:left-1/2 md:-translate-x-1/2 flex items-center justify-center gap-3 md:gap-4 pointer-events-auto z-10 w-full md:w-max">
                {logo && (
                        <img src={logo} alt="Restaurant Logo" class="h-8 md:h-14 w-auto object-contain drop-shadow-xl animate-fade-in flex-shrink-0" onerror="this.style.display='none'" />
                )}
                <div class="flex flex-col items-start justify-center">
                    <h1 class="text-bone-white font-sans font-bold uppercase tracking-widest text-sm md:text-xl mb-0.5 md:mb-1 drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] leading-none">{title}</h1>
                    <p id="zoom-hint-viewer" class="text-bone-white/80 text-[8px] md:text-[10px] tracking-[0.3em] font-medium uppercase transition-opacity duration-300 drop-shadow-md">
                        {hint}
                    </p>
                </div>
            </div>

            <!-- Derecha: Logo Esquina -->
            <div class="relative z-10 pointer-events-auto hidden md:block">
                {cornerLogo && (
                        <img src={cornerLogo} alt="Corner Logo" class="h-10 md:h-14 w-auto object-contain drop-shadow-xl opacity-90 hover:opacity-100 transition-opacity" onerror="this.style.display='none'" />
                )}
            </div>
        </div>

        <!-- CONTENEDOR PRINCIPAL DE LA IMAGEN -->
        <div class="absolute inset-0 w-full h-full flex items-center justify-center p-2 md:p-16 z-10 mt-10 md:mt-0" id="viewer-container">
            <img
                    id="viewer-img"
                    src={images[0]}
                    alt="Menu Page"
                    class="max-w-[95vw] max-h-[75vh] md:max-h-[85vh] object-contain drop-shadow-2xl transition-all duration-500 origin-center cursor-zoom-in"
                    data-images={JSON.stringify(images)}
                    draggable="false"
            />
        </div>

        <!-- CONTROLES DE NAVEGACIÓN Y PAGINACIÓN -->
        {images.length > 1 && (
                <>
                    <button id="viewer-prev" class="absolute left-2 md:left-10 top-1/2 -translate-y-1/2 z-50 bg-navy/50 hover:bg-coral text-bone-white p-2.5 md:p-5 rounded-full backdrop-blur-md border border-bone-white/20 transition-all duration-300 shadow-xl group hover:scale-105 pointer-events-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform md:w-[24px] md:h-[24px]"><path d="m15 18-6-6 6-6"/></svg>
                    </button>

                    <button id="viewer-next" class="absolute right-2 md:right-10 top-1/2 -translate-y-1/2 z-50 bg-navy/50 hover:bg-coral text-bone-white p-2.5 md:p-5 rounded-full backdrop-blur-md border border-bone-white/20 transition-all duration-300 shadow-xl group hover:scale-105 pointer-events-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform md:w-[24px] md:h-[24px]"><path d="m9 18 6-6-6-6"/></svg>
                    </button>

                    <div id="viewer-pagination" class="absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 md:gap-3 z-50 bg-navy/50 px-4 md:px-6 py-2 md:py-3 rounded-full backdrop-blur-md border border-bone-white/20 transition-opacity duration-300 shadow-xl pointer-events-auto"></div>
                </>
        )}
    </main>

    <!-- Script Dedicado para el Visor -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('viewer-container');
            const img = document.getElementById('viewer-img');
            const hint = document.getElementById('zoom-hint-viewer');
            const prevBtn = document.getElementById('viewer-prev');
            const nextBtn = document.getElementById('viewer-next');
            const pagination = document.getElementById('viewer-pagination');

            if (!img) return;

            const images = JSON.parse(img.getAttribute('data-images'));
            let currentIndex = 0;

            // Variables de Estado para el Zoom y Arrastre
            let isZoomed = false;
            let isDragging = false;
            let dragMoved = false; // Nos dirá si el usuario hizo click o arrastró

            let scale = 1;
            let translateX = 0;
            let translateY = 0;
            let startX = 0;
            let startY = 0;
            let initialClickX = 0;
            let initialClickY = 0;

            // Actualiza la paginación inferior
            const updatePagination = () => {
                if (!pagination) return;
                pagination.innerHTML = '';
                images.forEach((_, i) => {
                    const dot = document.createElement('div');
                    dot.className = `w-1.5 h-1.5 md:w-2 md:h-2 rounded-full transition-all duration-300 ${i === currentIndex ? 'bg-coral w-4 md:w-6' : 'bg-bone-white/30'}`;
                    pagination.appendChild(dot);
                });
            };

            // Aplica las transformaciones matemáticas a la imagen
            const applyTransform = (transition = false) => {
                img.style.transition = transition ? 'transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1)' : 'none';
                img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
            };

            // Cambiar de imagen (Siguiente/Anterior)
            const updateImage = () => {
                isZoomed = false;
                scale = 1;
                translateX = 0;
                translateY = 0;

                img.style.transition = 'opacity 0.3s ease-out, transform 0.3s ease-out';
                img.style.transform = 'scale(0.95)';
                img.style.opacity = '0';

                img.classList.remove('cursor-zoom-out', 'cursor-grab', 'cursor-grabbing');
                img.classList.add('cursor-zoom-in');
                if (hint) hint.classList.remove('opacity-0');

                setTimeout(() => {
                    img.src = images[currentIndex];
                    applyTransform(true);
                    img.style.opacity = '1';
                    updatePagination();
                }, 300);
            };

            // Toggle Principal del Zoom
            const toggleZoom = () => {
                if (!isZoomed) {
                    isZoomed = true;
                    scale = window.innerWidth < 768 ? 2 : 2.5;
                    translateX = 0;
                    translateY = 0;

                    if (hint) hint.classList.add('opacity-0');
                    if (prevBtn) prevBtn.classList.add('opacity-0', 'pointer-events-none');
                    if (nextBtn) nextBtn.classList.add('opacity-0', 'pointer-events-none');
                    if (pagination) pagination.classList.add('opacity-0', 'pointer-events-none');

                    img.classList.remove('cursor-zoom-in');
                    img.classList.add('cursor-grab');
                } else {
                    isZoomed = false;
                    scale = 1;
                    translateX = 0;
                    translateY = 0;

                    if (hint) hint.classList.remove('opacity-0');
                    if (prevBtn) prevBtn.classList.remove('opacity-0', 'pointer-events-none');
                    if (nextBtn) nextBtn.classList.remove('opacity-0', 'pointer-events-none');
                    if (pagination) pagination.classList.remove('opacity-0', 'pointer-events-none');

                    img.classList.remove('cursor-grab', 'cursor-grabbing');
                    img.classList.add('cursor-zoom-in');
                }
                applyTransform(true); // Activa la transición suave para el zoom in/out
            };

            // ==========================================
            // EVENTOS DE CARRUSEL
            // ==========================================
            if (prevBtn && nextBtn) {
                prevBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    currentIndex = currentIndex > 0 ? currentIndex - 1 : images.length - 1;
                    updateImage();
                });
                nextBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    currentIndex = currentIndex < images.length - 1 ? currentIndex + 1 : 0;
                    updateImage();
                });
                updatePagination();
            }

            // ==========================================
            // LÓGICA MOUSE (DESKTOP)
            // ==========================================
            img.addEventListener('mousedown', (e) => {
                if (isZoomed) {
                    e.preventDefault(); // Evita el fantasma de la imagen al arrastrar en navegadores
                    isDragging = true;
                    dragMoved = false;
                    initialClickX = e.clientX;
                    initialClickY = e.clientY;
                    startX = e.clientX - translateX;
                    startY = e.clientY - translateY;
                    img.classList.replace('cursor-grab', 'cursor-grabbing');
                }
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging && isZoomed) {
                    // Si se movió más de 5px, se considera arrastre y no un click simple
                    if (Math.abs(e.clientX - initialClickX) > 5 || Math.abs(e.clientY - initialClickY) > 5) {
                        dragMoved = true;
                    }
                    if (dragMoved) {
                        translateX = e.clientX - startX;
                        translateY = e.clientY - startY;
                        applyTransform(false); // Transición apagada para que siga al ratón al instante
                    }
                }
            });

            window.addEventListener('mouseup', () => {
                if (isDragging) {
                    isDragging = false;
                    img.classList.replace('cursor-grabbing', 'cursor-grab');
                }
            });

            // ==========================================
            // LÓGICA TÁCTIL (MÓVIL)
            // ==========================================
            img.addEventListener('touchstart', (e) => {
                if (isZoomed) {
                    isDragging = true;
                    dragMoved = false;
                    initialClickX = e.touches[0].clientX;
                    initialClickY = e.touches[0].clientY;
                    startX = e.touches[0].clientX - translateX;
                    startY = e.touches[0].clientY - translateY;
                }
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (isDragging && isZoomed) {
                    if (Math.abs(e.touches[0].clientX - initialClickX) > 5 || Math.abs(e.touches[0].clientY - initialClickY) > 5) {
                        dragMoved = true;
                    }
                    if (dragMoved) {
                        translateX = e.touches[0].clientX - startX;
                        translateY = e.touches[0].clientY - startY;
                        applyTransform(false);
                        e.preventDefault(); // IMPORTANTE: Evita que la página web intente hacer scroll nativo
                    }
                }
            }, { passive: false });

            window.addEventListener('touchend', () => {
                isDragging = false;
            });

            // ==========================================
            // EVENTO DE CLIC CENTRALIZADO
            // ==========================================
            img.addEventListener('click', (e) => {
                e.stopPropagation();
                // Solo activamos/desactivamos el zoom si el usuario NO arrastró la imagen
                if (!dragMoved) {
                    toggleZoom();
                }
            });

            // ==========================================
            // SWIPE PARA CAMBIAR DE PÁGINA (Solo si NO hay zoom)
            // ==========================================
            let swipeStartX = 0;
            let swipeEndX = 0;

            container.addEventListener('touchstart', e => {
                if (isZoomed) return;
                swipeStartX = e.changedTouches[0].screenX;
            }, {passive: true});

            container.addEventListener('touchend', e => {
                if (isZoomed) return;
                swipeEndX = e.changedTouches[0].screenX;

                const swipeThreshold = 50;
                if (swipeEndX < swipeStartX - swipeThreshold && nextBtn) nextBtn.click();
                if (swipeEndX > swipeStartX + swipeThreshold && prevBtn) prevBtn.click();
            }, {passive: true});

        });
    </script>
</Layout>