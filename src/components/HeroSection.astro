---
// src/components/HeroSection.astro
import { ui } from '../i18n/ui.js';

const pathname = Astro.url.pathname;
const idiomaActual: keyof typeof ui = pathname.startsWith('/es') ? 'es' : 'en';
const t = ui[idiomaActual];
---

<header class="relative h-screen w-full flex items-center justify-center overflow-hidden bg-navy">
 <!--
     FONDO DE VIDEO (LUXURY RESORT STYLE)
     - autoplay, loop, muted, playsinline: Son OBLIGATORIOS para que funcione solo en móviles.
     - poster: Una imagen estática que se muestra en la fracción de segundo antes de que cargue el video.
 -->
 <video
     autoplay
     loop
     muted
     playsinline
     preload="auto"
     disablepictureinpicture
     class="absolute inset-0 w-full h-full object-cover z-0"
     poster="/images/photo-5-home.jpg"
 >
    <!-- RUTA DEL VIDEO -->
    <source src="/videos/resort-presentation.webm" type='video/webm; codecs="vp9, opus"'/>
    <source src="/videos/resort-presentation.mp4" type="video/mp4" />
    Tu navegador no soporta videos HTML5.
 </video>

 <!-- Overlay Azul Marino -->
 <div class="absolute inset-0 bg-navy/40 z-0"></div>

 <!-- Gradiente en la parte superior -->
 <div class="absolute top-0 left-0 w-full h-48 bg-gradient-to-b from-navy/80 to-transparent z-0"></div>

 <!-- Contenido Central -->
 <div class="relative z-10 text-center text-bone-white px-4 max-w-5xl flex flex-col items-center mt-16">

  <p class="uppercase tracking-[0.4em] text-sm md:text-base mb-6 text-coral-soft font-semibold animate-fade-in opacity-0 text-shadow-sm">
     {t['hero.location']}
  </p>

  <h1 class="text-5xl md:text-7xl lg:text-8xl font-luxury mb-8 leading-tight animate-fade-in opacity-0 delay-300 text-shadow-sm">
     {t['hero.title']} <br><span class="italic font-light">{t['hero.subtitle']}</span>
  </h1>

  <p class="max-w-3xl mx-auto text-lg md:text-xl font-light mb-12 animate-fade-in opacity-0 delay-500 text-bone-white/90">
     {t['hero.description']}
  </p>

    <a href="#explore" class="animate-fade-in opacity-0 delay-500 inline-flex items-center gap-3 border border-bone-white px-8 py-4 uppercase tracking-widest text-sm hover:bg-bone-white hover:text-navy transition-all duration-500">
       {t['hero.button']}
       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</header>